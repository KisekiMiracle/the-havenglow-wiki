{
  "compatibility_date": "2026-03-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "the-havenglow-wiki",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "havenglow_wiki_db",
      "database_name": "havenglow-wiki-db",
      "database_id": "59282cac-42e8-4c7a-8cff-10f45dc3cd01",
    },
  ],
}
