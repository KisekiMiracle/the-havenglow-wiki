---
import BaseHead from '../components/BaseHead.astro';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<main class="flex flex-col w-full">
      <slot />
		</main>
	</body>
</html>

