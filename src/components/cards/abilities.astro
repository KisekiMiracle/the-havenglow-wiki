---
interface Props {
  title: string,
  target: "Single Enemy" | "All Enemies" | "Single Ally" | "All Allies" | "Area of Effect" | "Self" | "All Units" | "None",
  type?: "Active" | "Passive",
  element?: "Fire" | "Ice" | "Thunder" | "Earth" | "Wind" | "Water" | "Light" | "Dark" | "Neutral",
  damageType?: "Physical" | "Magical" | "True",
  piercesImmunity?: "Yes" | "No",
  duration?: number | string | null,
  cooldown?: number | "none",
  manaCost?: number | string,
  healthCost?: number | string,
  miscellaneousCost?: number | string,
  quote?: string,
}

const { title, type = "Passive", duration, target, element, damageType, piercesImmunity, cooldown, manaCost, healthCost, miscellaneousCost, quote }: Props = Astro.props;
---

<div class="container transition-all duration-200 hover:scale-105 bg-white shadow-md shadow-transparent hover:shadow-neutral-300 flex flex-col gap-1 rounded-2xl border border-neutral-300 p-8">
  <div class="flex md:flex-row flex-col gap-4 items-start">
    <slot name="icon"/>
    <div class="flex flex-col gap-2 w-full">
      <div class="flex items-center justify-between w-full">
        <h3 class="my-0!">{title}</h3>
        { type === "Passive" && <span class="whitespace-nowrap px-4 py-1 bg-blue-50 text-blue-700 rounded-md text-sm">◈ {type}</span>}
        { type === "Active" && <span class="whitespace-nowrap px-4 py-1 bg-emerald-50 text-emerald-700 rounded-md text-sm">◉ {type}</span>}
      </div>
      <div class="flex flex-col md:grid md:grid-cols-2 w-full">
        { damageType && 
        <p class="badge">
          <span class="font-bold">Damage Type:</span>
          <span>{damageType}</span>
        </p>}
        { piercesImmunity &&
        <p class="badge">
          <span class="font-bold">Pierces Status Immunity?:</span>
          <span>{piercesImmunity}</span>
        </p>}
        { element && 
        <p class="badge">
          <span class="font-bold">Element: </span>
          <span>{element}</span>
        </p>}
        { target && 
        <p class="badge">
          <span class="font-bold">Target:</span>
          <span>{target}</span>
        </p>}
      </div>
    </div>
  </div>
  <hr />
  <slot name="description" />
  <slot name="effects" />
  { quote && <blockquote class="text-neutral-500">{quote}</blockquote>}
  <div class="text-sm flex items-center justify-between gap-1">
    { cooldown && <p class="flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 512 512"><path fill="currentColor" d="M115.063 21.97v9.343c0 101.953 38.158 189.648 96.343 222.093v6.094c-58.186 32.445-96.344 120.14-96.344 222.094v9.344H401.81v-9.344c0-102.552-38.804-190.274-97.53-222.188V253.5c58.722-31.917 97.53-119.64 97.53-222.188V21.97H115.06zM134 40.655h248.875c-2.477 96.445-42.742 175.523-91.938 198.906l-5.343 2.532v28.751l5.344 2.53c49.193 23.383 89.456 102.438 91.937 198.876H134c2.456-95.898 42.125-175.078 90.875-198.938l5.25-2.562v-28.594l-5.25-2.562c-48.748-23.86-88.42-103.04-90.875-198.938zm213.656 86.125c-57.607 27.81-124.526 27.84-177.562 4.095C184.748 181.78 213.91 218.012 248.22 224a12.18 12.18 0 0 0-2.47 7.344c0 6.76 5.488 12.25 12.25 12.25s12.25-5.49 12.25-12.25c0-2.72-.907-5.218-2.406-7.25c35.426-5.88 65.488-44.07 79.812-97.313zM258 258.626c-6.762 0-12.25 5.488-12.25 12.25s5.488 12.25 12.25 12.25s12.25-5.488 12.25-12.25s-5.488-12.25-12.25-12.25m0 39.28c-6.762 0-12.25 5.49-12.25 12.25c0 6.763 5.488 12.25 12.25 12.25s12.25-5.487 12.25-12.25c0-6.76-5.488-12.25-12.25-12.25m0 39.533c-6.762 0-12.25 5.488-12.25 12.25c0 6.76 5.488 12.25 12.25 12.25s12.25-5.49 12.25-12.25c0-6.762-5.488-12.25-12.25-12.25m.125 39.906c-23.21.28-46.19 25.77-75.813 75.656h153c-30.523-51.003-53.977-75.936-77.187-75.656"/></svg>
      <span class="font-bold">{cooldown}</span>
    </p>}
    <div class="flex items-center gap-2">
      { manaCost && <p></p>}
    </div>
  </div>
</div>

<style scoped>
  .container {
    p {
      margin-block: 0 !important;
    }
    hr {
      margin-block: 0.5rem !important;
    }
    blockquote {
      margin-block: 1rem !important;
    }
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    
    span {
      white-space: preserve nowrap;
    }
  }
</style>

