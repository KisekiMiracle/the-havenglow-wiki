---
import HeaderLink from './HeaderLink.astro';
import SearchTrigger from '@/components/search/trigger.vue'

import { Image } from "astro:assets";
import Logo from "@/assets/logoipsum-216.png"

import { Popover } from 'webcoreui/astro'

import { jwtVerify } from 'jose';
import { actions } from 'astro:actions';

const session = Astro.cookies.get('session')?.value;

let isLoggedIn = false;

if (session) {
  try {
    const SECRET = new TextEncoder().encode(import.meta.env.JWT_SECRET);
    await jwtVerify(session, SECRET);
    isLoggedIn = true;
  } catch (e: any) {
    // expired or invalid — treat as logged out
    isLoggedIn = false;
  }
}

const result = Astro.getActionResult(actions.user.logout);
if (result && !result.error) {
	const PROTECTED = ["/admin"];
	const isProtected = PROTECTED.some((path) => Astro.url.pathname.startsWith(path));

	if (isProtected) return Astro.redirect('/')
  return Astro.redirect(Astro.url.pathname);
}
---

<header class="sticky top-0 isolate z-9 flex w-full flex-col items-center px-0!">
	<nav class="w-full max-w-6/12 self-center py-7">
		<h2>
			<a href="/">
				<Image src={Logo} alt="Havenglow Wiki Logo" width={140} />
			</a>
		</h2>
		<div class="flex items-center gap-8">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/wiki">Wiki</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="flex items-center gap-4">
			<SearchTrigger client:only="vue" />
			<button type="button" class="hover:cursor-pointer popover-trigger rounded-sm bg-neutral-50 transition-colors! duration-200 hover:bg-neutral-100">
				<div class="p-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M11.5 14c4.14 0 7.5 1.57 7.5 3.5V20H4v-2.5c0-1.93 3.36-3.5 7.5-3.5m6.5 3.5c0-1.38-2.91-2.5-6.5-2.5S5 16.12 5 17.5V19h13zM11.5 5A3.5 3.5 0 0 1 15 8.5a3.5 3.5 0 0 1-3.5 3.5A3.5 3.5 0 0 1 8 8.5A3.5 3.5 0 0 1 11.5 5m0 1A2.5 2.5 0 0 0 9 8.5a2.5 2.5 0 0 0 2.5 2.5A2.5 2.5 0 0 0 14 8.5A2.5 2.5 0 0 0 11.5 6"/></svg>
				</div>
			</button>
			<Popover className="popover">
				{!isLoggedIn ? (				
					<form class="flex flex-col gap-1" data-login-form>
						<h3 class="text-lg font-semibold">Sign In</h3>
						<label>
							<span class="text-sm text-neutral-500">Email</span>
							<input id="email" name="email"  placeholder="your@email.com" class="w-full rounded-md border border-neutral-300 px-2 py-1 transition-colors duration-200"/>
						</label>
						<small class="text-rose-600" data-login-form-error />
						<small class="text-emerald-600" data-login-form-success />
						<button type="submit" class="mt-2 w-full rounded-md bg-neutral-900 px-4 py-2 text-sm text-white transition-colors duration-200 hover:cursor-pointer hover:bg-neutral-700 disabled:hover:cursor-not-allowed" data-login-form-button>
							Send Magic Link
						</button>
					</form>
				) : (
				<form class="flex flex-col gap-1" method="POST" action={actions.user.logout}>
						<span>Welcome back.</span>
						<button type="submit" class="mt-2 w-full rounded-md bg-pink-600 px-4 py-2 text-sm text-white transition-colors duration-200 hover:cursor-pointer hover:bg-pink-700 disabled:hover:cursor-not-allowed" data-login-form-button>
							Log Out
						</button>
					</form>
				)}
			</Popover>
		</div>
	</nav>
</header>

<style scoped>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

<script>
    import { popover } from 'webcoreui'
		import { actions } from 'astro:actions';
		import { isInputError } from 'astro:actions';

		document.addEventListener("astro:page-load", () => {
			popover({
					trigger: '.popover-trigger',
					popover: '.popover'
			});

			// NOTE: FORM SUBMISSION
			const form: HTMLFormElement = document.querySelector('[data-login-form]')!;
			const errorText: HTMLSpanElement = document.querySelector('[data-login-form-error]')!;
			const successText: HTMLSpanElement = document.querySelector('[data-login-form-success]')!;

			const button: HTMLButtonElement = document.querySelector('[data-login-form-button]')!;

			if (form) form.addEventListener("submit", async (e) => {
				e.preventDefault();
				
				const ogText = button.innerText;
				button.innerText = "Loading...";
				button.disabled = true;

				errorText.innerText	= '';
				successText.innerText = '';

				const formData = new FormData(form);

				const { data, error } = await actions.user.login(formData);

				if (isInputError(error)) {
					if (error.fields.email) {
						errorText.innerText = error.fields.email[0];
					}

					button.innerText = ogText;
					button.disabled = false;
					return;
				}

				if (data) {
					if ( data!.error ) {
						errorText.innerText = data!.error;

						button.innerText = ogText;
						button.disabled = false;
						return;
					}
				}

				if (error) {
					errorText.innerText = 'Something went wrong. Please try again.';
					button.innerText = ogText;
					button.disabled = false;
					return;
				}

				successText.innerText = data!.message as string;
				button.disabled = false;
				button.innerText = ogText;
			});
		});
</script>
