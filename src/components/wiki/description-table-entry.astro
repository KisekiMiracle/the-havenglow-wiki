---
import { cn } from "@/lib/utils";

interface Props {
  label: string;
  hasNextElement?: boolean;
}

const { label, hasNextElement = true }: Props = Astro.props;
---

<div class={cn("grid grid-cols-2 bg-neutral-50", {
  "pb-2 border-b border-b-neutral-400": hasNextElement
})}>
  <!-- left -->
  <span class="font-bold">{label}</span>

  <!-- right -->
  <span class="flex flex-col gap-0">
    <slot />
  </span>
</div>
