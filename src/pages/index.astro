---
import MainLayout from '../layouts/MainLayout.astro';
import SectionLink from '@/components/SectionLink.astro';
import SearchTrigger from '@/components/search/trigger.vue'

import CardArray from "@/components/cards/array.astro";
---
<MainLayout title="Home | Kiseki's Atelier" description="My site.">
	<section class="flex h-84 w-full flex-col mb-10 items-center justify-center gap-4 self-center px-8 lg:max-w-3/12 lg:px-0">
		<h1 class="text-center text-4xl font-semibold">The Havenglow Wiki</h1>
		<p class="inline-flex flex-wrap items-center justify-center gap-1 text-center">A compendium of information from <SectionLink href="/" label="Project Havenglow"/>, <SectionLink href="/" label="Project Arcadia"/>, and other projects.</p>
		<SearchTrigger client:only="vue" width="full" />
	</section>
	<section class="w-full max-w-6/12 self-center pb-12">
		<CardArray />
	</section>
	<section class="w-full max-w-6/12 self-center">
	</section>
</MainLayout>
